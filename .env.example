ASI_ONE_API_KEY=
# Models are configurable in case ASI:One renames them.
ASI_MODEL_LARGE=asi1
ASI_MODEL_SMALL=asi1-mini
USE_FIXTURES=1
TZ=America/Los_Angeles

GROUP_AGENT_SEED=
GROUP_AGENT_PORT=8000
# Leave empty to use an Agentverse mailbox. Set to a public https URL ending in /submit
# (e.g. an ngrok tunnel to GROUP_AGENT_PORT) for Agentverse "Launch an Agent" registration.
GROUP_AGENT_ENDPOINT=
GROUP_INVITE_CODE=
HOME_BASE_LAT=37.7599
HOME_BASE_LNG=-122.4148
HOME_BASE_LABEL=Mission, SF
DB_PATH=./data/lore.db
TICKETMASTER_API_KEY=
PLACES_API_KEY=

MEMBER_NAME=
MEMBER_AGENT_SEED=
MEMBER_PORT=8001
MEMBER_AGENT_ENDPOINT=
MEMBER_STATE_PATH=./data/member_<name>.json
GROUP_AGENT_ADDRESS=

PUSH_ENABLED=0
