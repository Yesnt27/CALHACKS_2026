ASI_ONE_API_KEY=
# Models are configurable in case ASI:One renames them.
ASI_MODEL_LARGE=asi1
ASI_MODEL_SMALL=asi1-mini
USE_FIXTURES=1
TZ=America/Los_Angeles

GROUP_AGENT_SEED=
GROUP_AGENT_PORT=8000
GROUP_INVITE_CODE=
HOME_BASE_LAT=37.7599
HOME_BASE_LNG=-122.4148
HOME_BASE_LABEL=Mission, SF
DB_PATH=./data/lore.db
TICKETMASTER_API_KEY=
PLACES_API_KEY=

MEMBER_NAME=
MEMBER_AGENT_SEED=
MEMBER_PORT=8001
MEMBER_STATE_PATH=./data/member_<name>.json
GROUP_AGENT_ADDRESS=

PUSH_ENABLED=0

# Discord chat as a lore source (scripts/discord_lore_import.py), read through
# github.com/Microck/discord.py-self-mcp. It logs in as a user account: throwaway accounts only.
# Either point at a server you started (the token then stays in that process) ...
DISCORD_MCP_URL=
# ... or spawn it over stdio; DISCORD_TOKEN is passed to that child process only.
DISCORD_MCP_COMMAND=
DISCORD_TOKEN=
DISCORD_LORE_CHANNEL_IDS=
# discord username -> member name, e.g. alex.codes=Alex,samwise_k=Sam
DISCORD_MEMBER_MAP=
